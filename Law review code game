import random

questions = [
    {
        "question": "What is the highest standard of proof in criminal law?",
        "answer": "beyond a reasonable doubt"
    },
    {
        "question": "Which amendment protects against unreasonable searches and seizures?",
        "answer": "4th amendment"
    },
    {
        "question": "What is the formal written law enacted by a legislature called?",
        "answer": "statute"
    },
    {
        "question": "What court is the highest court in the United States?",
        "answer": "supreme court"
    },
    {
        "question": "What is the standard needed to make an arrest?",
        "answer": "probable cause"
    },
    {
        "question": "What amendment protects against self-incrimination?",
        "answer": "5th amendment"
    },
    {
        "question": "What is a civil wrong called?",
        "answer": "tort"
    },
    {
        "question": "Who prosecutes criminal cases for the state?",
        "answer": "district attorney"
    }
]

score = 0

print("⚖️ INTRO TO LAW QUIZ GAME ⚖️")
print("Answer the questions correctly to earn points!\n")

random.shuffle(questions)

for q in questions:
    user_answer = input(q["question"] + "\n> ").strip().lower()

    if user_answer == q["answer"]:
        print("✅ Correct!\n")
        score += 1
    else:
        print(f"❌ Incorrect. The answer was: {q['answer']}\n")

print(f"Game Over! Your score: {score}/{len(questions)}")

if score == len(questions):
    print("🏆 Perfect Score!")
elif score >= len(questions) // 2:
    print("👍 Good job!")
else:
    print("📚 Keep studying and try again!")
